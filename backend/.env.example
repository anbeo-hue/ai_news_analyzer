# Sao chép file này thành ".env" rồi điền giá trị. Không đưa file .env lên GitHub.

# Khóa API lấy ở Google AI Studio (dự án mới cho đồ án này, không dùng lại key AI4LIFE)
GEMINI_API_KEY=

# Dùng đúng tên model bạn đã dùng ở AI4Life (xem trong AI Studio)
GEMINI_MODEL=gemini-3.8-flash

# true = chạy thử với kết quả giả, KHÔNG gọi Gemini (dùng khi chưa có key). Có key thì đổi thành false.
USE_MOCK_AI=true

# Địa chỉ trang web được phép gọi API này (cách nhau bằng dấu phẩy)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,null

REQUEST_TIMEOUT=30
MAX_ARTICLE_CHARS=12000
